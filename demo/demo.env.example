# Copy this file to demo.env and fill it in. demo.env is ignored by git.

# Where the portal is running (php -S localhost:8000 in the project folder)
APP_URL=http://localhost:8000

# A student account that is a member of PROJECT_ID, and an admin account
# (make the admin once with init_admin.php)
STUDENT_USERNAME=
STUDENT_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# The project whose timeline, meetings and literature matrix the demo shows.
# Open it in the browser and copy the id from the address bar (Project_details.php?id=...).
PROJECT_ID=

# Two short research-paper PDFs for the literature matrix, separated by a comma
# (paths relative to this folder, or full paths)
PAPERS=
MATRIX_TAGS=Method, Dataset, Results

# What the demo types
SEARCH_TERM=machine learning

# off = skip creating a new project (each run adds one to your database)
CREATE_PROJECT=on
NEW_PROJECT_TITLE=Bangla Handwriting Recognition for Receipts
NEW_PROJECT_ABSTRACT=We build a dataset of handwritten Bangla receipts and train an OCR model to read them.
NEW_PROJECT_FIELD=Computer Vision
NEW_PROJECT_KEYWORDS=OCR, Bangla
# Optional cover image for the new project
COVER_IMAGE=

# off = skip scheduling a meeting (each run adds one to the project)
CREATE_MEETING=on
MEETING_TITLE=Weekly progress review
MEETING_LINK=https://meet.google.com/abc-defg-hij

# Browser size (16:9) and pace: SPEED=2 plays twice as fast, 0.5 half as fast
WINDOW=1440x810
SPEED=1
CAPTIONS=on

# on = also save Playwright's own recording to demo/videos (lower quality than a screen recording)
RECORD_VIDEO=off

# on = run without a window and stop at the first failed step (for checking the script)
HEADLESS=off
