# Deny direct access to all files in storage directory
# Files must be accessed through download.php proxy

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Prevent directory listing
Options -Indexes

# Prevent .htaccess from being viewed
<Files .htaccess>
    Require all denied
</Files>
